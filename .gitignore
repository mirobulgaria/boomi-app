# ============================================================
# Boomi Builder
# Repository ignore policy
# ============================================================


# ------------------------------------------------------------
# Python virtual environments
# ------------------------------------------------------------

.venv/
venv/
env/
ENV/


# ------------------------------------------------------------
# Python bytecode / caches
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

.coverage
.coverage.*
htmlcov/


# ------------------------------------------------------------
# Python packaging / build artifacts
# ------------------------------------------------------------

*.egg
*.egg-info/
.eggs/

build/
dist/

pip-wheel-metadata/


# ------------------------------------------------------------
# Python tooling
# ------------------------------------------------------------

.tox/
.nox/

*.log


# ------------------------------------------------------------
# Environment / local configuration
#
# Do not commit runtime environment variables or local secrets.
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.local


# ------------------------------------------------------------
# Secrets / credentials
#
# Never commit plaintext or protected operational credentials.
# ------------------------------------------------------------

secrets/
**/secrets/

*.dpapi
*.secret
*.secrets

credentials.json
credentials.*.json


# ------------------------------------------------------------
# Runtime application data
#
# data/.gitkeep is intentionally tracked.
#
# This includes:
#
#   data/connections.json
#   data/secrets/
#   future operational application state
#
# ------------------------------------------------------------

data/*
!data/.gitkeep


# ------------------------------------------------------------
# Local project runtime data
#
# projects/.gitkeep is intentionally tracked.
#
# Project-specific runtime workspaces, generated artifacts,
# imported evidence and operational state must not be committed
# by default.
# ------------------------------------------------------------

projects/*
!projects/.gitkeep


# ------------------------------------------------------------
# Runtime logs
# ------------------------------------------------------------

logs/*
!logs/.gitkeep


# ------------------------------------------------------------
# Temporary / backup files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

*~
~$*


# ------------------------------------------------------------
# Databases / local persistence
# ------------------------------------------------------------

*.db
*.sqlite
*.sqlite3


# ------------------------------------------------------------
# Generated exports / backups
# ------------------------------------------------------------

exports/
backups/

**/exports/
**/backups/


# ------------------------------------------------------------
# Test-generated artifacts
# ------------------------------------------------------------

coverage.xml

test-results/
pytest-report/


# ------------------------------------------------------------
# IDE / editor metadata
# ------------------------------------------------------------

.vscode/
.idea/

*.code-workspace

.vs/


# ------------------------------------------------------------
# Windows
# ------------------------------------------------------------

Thumbs.db
Thumbs.db:encryptable
Desktop.ini

$RECYCLE.BIN/


# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride


# ------------------------------------------------------------
# Local engine checkpoints
#
# Git history is the authoritative source/version history.
#
# Manual engine snapshots may be retained locally for
# development recovery but must not be committed.
#
# IMPORTANT:
# Only engine/checkpoints/ is ignored.
# The embedded engine itself remains version-controlled.
# ------------------------------------------------------------

engine/checkpoints/


# ------------------------------------------------------------
# IMPORTANT
#
# The embedded Boomi CLI engine is intentionally versioned:
#
#   engine/boomi-cli/
#
# The engine baseline files are intentionally versioned:
#
#   engine/BASELINE.md
#   engine/BASELINE_SHA256SUMS.txt
#
# Application source and architecture documentation are also
# intentionally versioned.
#
# Do NOT add broad rules such as:
#
#   engine/
#   backend/
#   docs/
#
# ------------------------------------------------------------